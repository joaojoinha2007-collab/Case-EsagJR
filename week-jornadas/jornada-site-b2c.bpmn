<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_WEEK2" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
<bpmn:collaboration id="Collab"><bpmn:participant id="Pool" name="WEEK Haircare: jornada do cliente dentro do site" processRef="Proc"/></bpmn:collaboration>
<bpmn:process id="Proc" name="Jornada do cliente dentro do site" isExecutable="false"><bpmn:laneSet id="LS">
<bpmn:lane id="L0" name="Cliente"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>S1</bpmn:flowNodeRef><bpmn:flowNodeRef>S3</bpmn:flowNodeRef><bpmn:flowNodeRef>D1</bpmn:flowNodeRef><bpmn:flowNodeRef>S6</bpmn:flowNodeRef><bpmn:flowNodeRef>D2</bpmn:flowNodeRef><bpmn:flowNodeRef>S9</bpmn:flowNodeRef><bpmn:flowNodeRef>S10</bpmn:flowNodeRef><bpmn:flowNodeRef>S12</bpmn:flowNodeRef><bpmn:flowNodeRef>E2</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L1" name="Site e e-commerce"><bpmn:flowNodeRef>S2</bpmn:flowNodeRef><bpmn:flowNodeRef>S4</bpmn:flowNodeRef><bpmn:flowNodeRef>S7</bpmn:flowNodeRef><bpmn:flowNodeRef>S8</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef><bpmn:flowNodeRef>S11</bpmn:flowNodeRef><bpmn:flowNodeRef>D3</bpmn:flowNodeRef><bpmn:flowNodeRef>S13</bpmn:flowNodeRef><bpmn:flowNodeRef>S16</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L2" name="Sócia de Comercial e Marketing"><bpmn:flowNodeRef>S5</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L3" name="Sócia de Operações e Financeiro"><bpmn:flowNodeRef>S14</bpmn:flowNodeRef><bpmn:flowNodeRef>S15</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s" name="Chega ao site pelo Reels, Google ou link"><bpmn:outgoing>f0</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="S1" name="J1: Acessar a página inicial"><bpmn:incoming>f0</bpmn:incoming><bpmn:outgoing>f1</bpmn:outgoing></bpmn:task>
<bpmn:task id="S2" name="J2: Exibir banners, kits e benefícios"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task>
<bpmn:task id="S3" name="J3: Escolher um produto ou kit"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:task>
<bpmn:task id="S4" name="J4: Mostrar preço, ingredientes e avaliações"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="D1" name="D1: Tem dúvida sobre o produto?"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="S5" name="J5: Tirar as dúvidas pelo chat ou WhatsApp"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:task>
<bpmn:task id="S6" name="J6: Adicionar o produto ao carrinho"><bpmn:incoming>f5</bpmn:incoming><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:task>
<bpmn:task id="S7" name="J7: Mostrar o frete e sugerir kits"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="D2" name="D2: Segue para o checkout?"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing><bpmn:outgoing>f11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="S8" name="J8: Enviar e-mail de carrinho abandonado com cupom"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="E1" name="Cliente reimpactado pode voltar ao carrinho"><bpmn:incoming>f12</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="S9" name="J9: Fazer login ou cadastro e informar o endereço"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:task>
<bpmn:task id="S10" name="J10: Escolher frete, cupom e forma de pagamento"><bpmn:incoming>f13</bpmn:incoming><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:task>
<bpmn:task id="S11" name="J11: Processar o pagamento"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="D3" name="D3: Pagamento aprovado?"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing><bpmn:outgoing>f17</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="S12" name="J12: Tentar outra forma de pagamento"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:task>
<bpmn:task id="S13" name="J13: Confirmar o pedido e enviar e-mail ao cliente"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:task>
<bpmn:task id="S14" name="J14: Receber o pedido no painel e separar os produtos"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:task>
<bpmn:task id="S15" name="J15: Emitir a nota fiscal e enviar com rastreio"><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing></bpmn:task>
<bpmn:task id="S16" name="J16: Atualizar o status e enviar o rastreio"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="E2" name="Cliente recebe o pedido em casa"><bpmn:incoming>f22</bpmn:incoming></bpmn:endEvent>
